<?xml version="1.0" encoding="utf-8"?>
<!-- Token i dane treningowe nie trafiają do kopii zapasowej ani transferu urządzenie-urządzenie
     (klucz Keystore i tak nie przeżyłby przeniesienia). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
