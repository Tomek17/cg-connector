# Skopiuj do .env (NIGDY nie commituj .env). Wartości uzupełnia Tomek na serwerze.
# Katalog danych: tu powstaje baza SQLite cg.sqlite (z zaszyfrowanymi tokenami Garmina).
CG_DATA_DIR=/data
CG_TIMEZONE=Europe/Warsaw
CG_SYNC_HOUR=14
# Klucz Fernet do szyfrowania tokenów Garmina. Wygeneruj: cg-server gen-key
# Zmiana/utrata klucza = konieczne ponowne cg-server garmin-login dla każdego użytkownika.
CG_ENCRYPTION_KEY=
