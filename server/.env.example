# Wzór pliku .env. Skopiuj:  cp .env.example .env  i uzupełnij wartości.
# NIGDY nie commituj pliku .env (jest w .gitignore). Ten plik ma tylko puste wartości.

# --- Serwer cg-server -------------------------------------------------------
# Katalog danych WEWNĄTRZ kontenera (nie zmieniaj). Tu powstaje baza cg.sqlite.
CG_DATA_DIR=/data
CG_TIMEZONE=Europe/Warsaw
CG_SYNC_HOUR=14
# Klucz Fernet do szyfrowania tokenów Garmina. Wygeneruj:
#   docker compose run --rm cg-server cg-server gen-key
# Zachowaj go razem z folderem danych. Zmiana/utrata klucza = ponowne
# cg-server garmin-login dla każdego użytkownika.
CG_ENCRYPTION_KEY=
# Publiczna nazwa hosta z tunelu (bez https://), np. cg-server.tail1234.ts.net.
# Adres konektora w claude.ai: https://<CG_PUBLIC_HOST>/mcp
CG_PUBLIC_HOST=
# production (domyślnie) ukrywa /openapi.json; inna wartość (np. test) go udostępnia.
CG_ENV=production
# true = dopuść redirect OAuth na http://localhost (MCP Inspector, testy). Na serwerze: false.
CG_OAUTH_ALLOW_LOCALHOST=false
# Limity: maks. rozmiar żądania (bajty) i liczba żądań/min z jednego IP na endpointy OAuth.
CG_MAX_REQUEST_BYTES=1048576
CG_RATE_LIMIT_PER_MINUTE=30

# --- Folder danych na komputerze (WSL) --------------------------------------
# Stan serwera: baza SQLite i kopie zapasowe.
# Pusto = ./data obok compose.yaml. Zalecane: ścieżka bezwzględna, np. /home/<ty>/cg-data
CG_HOST_DATA_DIR=
# Stan Tailscale (tożsamość maszyny cg-server), osobno, żeby serwer go nie widział.
# Pusto = ./tailscale-state obok compose.yaml. Zalecane: /home/<ty>/cg-tailscale
# Przeniesienie na inny komputer = skopiowanie obu folderów + pliku .env.
CG_HOST_TS_DIR=

# --- Tailscale (tunel Funnel) -----------------------------------------------
# Jednorazowy klucz z panelu Tailscale (Settings -> Keys -> Generate auth key,
# zaznacz "Pre-approved"). Potrzebny tylko przy pierwszym uruchomieniu;
# po rejestracji maszyny cg-server można tę wartość usunąć.
TS_AUTHKEY=
